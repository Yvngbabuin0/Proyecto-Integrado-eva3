# Copia este archivo como .env y completa los valores. El .env nunca se sube al repositorio.

# Clave secreta de Django. Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 1 en desarrollo, 0 en producción
DJANGO_DEBUG=1

# Hosts permitidos, separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
